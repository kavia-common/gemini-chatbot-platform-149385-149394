# Backend environment example

# Required: Google Generative AI API key
# Obtain one and set it here before running the backend.
GEMINI_API_KEY=

# Optional: Explicit model selection. If unset, defaults to gemini-2.5-flash.
# Ensure your key/SDK has access to the selected model.
#GEMINI_MODEL=gemini-2.5-flash

# Database URL (SQLAlchemy format). If unset, falls back to local SQLite file chat.db
# Example for Postgres:
#DATABASE_URL=postgresql+psycopg2://chat_user:chat_pass@localhost:5432/chat_db

# CORS: Allowed origin(s) for frontend. Comma-separated list supported.
# Defaults if unset: http://localhost:3000 and a regex for the workspace preview domain on port 3000.
# Example (single):
#FRONTEND_ORIGIN=http://localhost:3000
# Example (multiple):
#FRONTEND_ORIGIN=http://localhost:3000,https://my-preview.example.com:3000

# Legacy fallback (still supported). If set to '*', allows all origins.
#CORS_ALLOWED_ORIGINS=*
