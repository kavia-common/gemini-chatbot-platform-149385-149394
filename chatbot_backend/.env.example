# Backend environment variables

# Google Generative AI API key (required)
GEMINI_API_KEY=your_api_key_here

# Optional: override default model (defaults to gemini-1.5-flash if unset)
# Common options: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# Database URL; falls back to local SQLite if unset
# Example for Postgres via docker-compose in chatbot_database:
# DATABASE_URL=postgresql+psycopg2://chat_user:chat_pass@localhost:5432/chat_db
# DATABASE_URL=

# CORS allowed origins (comma-separated) or * for all
CORS_ALLOWED_ORIGINS=*
