# Example environment for chatbot_backend

# REQUIRED: Your Google Generative AI API key
GEMINI_API_KEY=your_api_key_here

# OPTIONAL: Model to use. If unsupported by the installed SDK, the backend will fall back to a supported model.
# Common options: gemini-1.5-flash, gemini-1.5-flash-8b, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# OPTIONAL: CORS origins (comma-separated). Use * for all.
CORS_ALLOWED_ORIGINS=*

# OPTIONAL: Database URL. Defaults to local SQLite if not set.
# For Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
# DATABASE_URL=postgresql+psycopg2://chat_user:chat_pass@localhost:5432/chat_db
