# Google Generative AI (Gemini)
# REQUIRED: API key for the Gemini API
GEMINI_API_KEY=your_api_key_here

# OPTIONAL: Model to use. If unset, backend defaults to gemini-2.5-flash.
# The backend honors this value verbatim and does not silently fall back.
# Example values: gemini-2.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash

# CORS
CORS_ALLOWED_ORIGINS=*

# Database URL (optional; defaults to local SQLite when unset)
# e.g., postgresql+psycopg2://chat_user:chat_pass@localhost:5432/chat_db
# DATABASE_URL=
