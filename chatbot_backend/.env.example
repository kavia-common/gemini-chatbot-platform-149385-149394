# Backend environment variables

# Google Generative AI
GEMINI_API_KEY=
# Optional model override (e.g., gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# CORS / Frontend origin
# Comma-separated list of allowed origins. Example for local dev and preview:
# FRONTEND_ORIGIN=http://localhost:3000,https://vscode-internal-*.cloud.kavia.ai:3000
# Legacy alias still supported:
# CORS_ALLOWED_ORIGINS=*

# Server binding
FLASK_HOST=0.0.0.0
FLASK_PORT=3001
# FLASK_DEBUG=1

# Database (optional; defaults to local SQLite chat.db)
# DATABASE_URL=postgresql+psycopg2://chat_user:chat_pass@localhost:5432/chat_db
